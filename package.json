{
  "name": "notebooklm-mcp-audio-custom",
  "version": "0.0.7",
  "description": "MCP server for Google NotebookLM — chat, source ingestion, audio overviews, citations, stdio + Streamable-HTTP transports.",
  "type": "module",
  "bin": {
    "notebooklm-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "prepare": "npm run build",
    "test": "npm run test:workflow-security && npm run test:lineage && npm run test:trusted-releases && npm run test:install-release && npm run test:auth-persistence && npm run test:tool-compatibility && npm run test:hosts && npm run test:audio && npm run test:http && npm run test:core && npm run test:permissions && npm run test:launcher && npm run test:installer && npm run test:youtube && npm run test:readiness && npm run test:transcript && npm run test:workflow && npm run test:chat && npm run test:source-release",
    "test:auth-persistence": "npm run build && node scripts/test-auth-persistence.mjs",
    "test:source-release": "bash scripts/test-source-release.sh",
    "test:youtube": "node scripts/test-youtube-source.mjs",
    "test:readiness": "node scripts/test-source-readiness.mjs",
    "test:transcript": "node scripts/test-transcript-export.mjs",
    "test:workflow": "node scripts/test-workflow-integration.mjs",
    "test:chat": "npm run build && node scripts/test-chat-stability.mjs",
    "test:audio": "npm run build && node scripts/test-audio-validation.mjs",
    "test:hosts": "npm run build && node scripts/test-notebook-hosts.mjs",
    "test:http": "npm run build && node scripts/test-http-concurrency.mjs",
    "test:core": "npm run build && node scripts/test-core-concurrency.mjs",
    "test:permissions": "npm run build && node scripts/test-auth-permissions.mjs",
    "test:launcher": "bash scripts/test-launcher-env.sh",
    "test:installer": "bash scripts/test-installer-bootstrap.sh",
    "test:workflow-security": "node scripts/test-workflow-security.mjs",
    "test:lineage": "bash scripts/test-upstream-lineage.sh && bash scripts/verify-upstream-lineage.sh",
    "test:install-release": "bash scripts/test-install-release.sh",
    "test:tool-compatibility": "node scripts/test-tool-compatibility.mjs && node scripts/verify-tool-compatibility.mjs",
    "test:trusted-releases": "node scripts/test-trusted-releases.mjs && node scripts/verify-trusted-releases.mjs --skip-remote-tags",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check": "npm run format:check && npm run lint && npm run build"
  },
  "keywords": [
    "mcp",
    "notebooklm",
    "gemini",
    "ai",
    "claude"
  ],
  "author": "sasuketorii (https://github.com/sasuketorii)",
  "contributors": [
    {
      "name": "Gérôme Dexheimer",
      "email": "hello@geromedexheimer.de",
      "url": "https://github.com/PleasePrompto"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasuketorii/notebooklm_mcp_with.git"
  },
  "homepage": "https://github.com/sasuketorii/notebooklm_mcp_with#readme",
  "bugs": {
    "url": "https://github.com/sasuketorii/notebooklm_mcp_with/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.0",
    "env-paths": "^3.0.0",
    "globby": "^16.2.2",
    "patchright": "^1.48.2",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "minimatch": {
      "brace-expansion": "^5.0.8"
    },
    "micromatch": {
      "picomatch": "^2.3.2"
    }
  }
}
